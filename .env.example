# Cloudflare Access 설정
CF_ACCESS_TEAM_DOMAIN=example-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace-with-access-application-aud
CF_ACCESS_ADMIN_EMAIL=admin@example.com


# GitHub Apps 설정
GITHUB_APP_ID=123456
GITHUB_AUTH_LOCAL_DEV=0     # 로컬: 1 | 운영: 0
GITHUB_APP_CLIENT_ID=replace-with-client-id
GITHUB_APP_CLIENT_SECRET=replace-with-client-secret
GITHUB_AUTH_REDIRECT_URI=http://localhost:5173/api/auth/github/callback
GITHUB_AUTH_ADMIN_USER_ID=12345678